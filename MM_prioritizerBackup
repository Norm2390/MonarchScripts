      if (id === 'A1-C1') a.occ = 1;
      else {
        a.occ = 0;
        for (const c of a.sources) {
          const src = resolve(c.slice(0, -1));
          if (src) a.occ += (c.slice(-1) === 'P' ? src.s : 1 - src.s) * src.occ;
        }
      }
      return a;
    };
    let success = 0;
    for (const id in map) {
      resolve(id);
      if (map[id].t === 'g') success += map[id].occ;
    }
    return success;
  }

