    document.body.appendChild(panel);

    panel.querySelectorAll(".tt2p-tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        panel.querySelectorAll(".tt2p-tab-btn").forEach((b) => b.classList.remove("tt2p-tab-active"));
