    const resolve = (id) => {
      const a = map[id];
      if (!a || done[id]) return a;
      done[id] = true;
      if (a.roles) {
        a.s = a.roles.reduce((sum, r) => sum + (passRates[r] ?? 0), 0) / (100 * a.roles.length);
