      let val = parseInt(input.value, 10);
      if (!Number.isFinite(val) || val < 1) val = 1;
      if (val > 10) val = 10;
      input.value = val;
      maxDifficultyLevel = val;
      localStorage.setItem(MAX_DIFFICULTY_KEY, String(val));
      showToast(`Max OC difficulty set to ${val}/10.`);
      runPass();
    });

